{
  "manifest_version": "0.4",
  "name": "@nimblebraininc/synapse-crm",
  "version": "0.3.2",
  "description": "Lightweight contact and deal tracker with agent-driven follow-ups and pipeline reviews.",
  "author": {
    "name": "NimbleBrain Inc."
  },
  "icon": "https://static.nimblebrain.ai/icons/crm.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/NimbleBrainInc/synapse-crm"
  },
  "server": {
    "type": "python",
    "entry_point": "synapse_crm.server",
    "mcp_config": {
      "command": "python",
      "args": [
        "-m",
        "synapse_crm.server"
      ]
    }
  },
  "_meta": {
    "org.mpaktrust": {
      "mtf_version": "0.1",
      "permissions": {
        "filesystem": "write",
        "network": "none",
        "environment": "read",
        "subprocess": "none",
        "native": "none"
      }
    },
    "ai.nimblebrain/host": {
      "placements": [
        {
          "slot": "sidebar.apps",
          "resourceUri": "ui://crm/main",
          "route": "@nimblebraininc/synapse-crm",
          "label": "CRM",
          "icon": "users"
        }
      ]
    }
  }
}
